# Public Firebase web configuration. Vite embeds these values in the browser bundle.
# These are identifiers/configuration, not Firebase Admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin service-account configuration. Never use a VITE_ prefix.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only Google Gemini key. Needed for receipt scanning and AI features.
GEMINI_API_KEY=

# Optional runtime settings. The server defaults to port 5000; npm start sets production mode.
PORT=5000
NODE_ENV=